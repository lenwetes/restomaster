# =========================================================================
# RestoMaster - Entorno de Producción Seguro (Coolify / Docker / VPS)
# =========================================================================

APP_NAME="RestoMaster"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com

LOG_CHANNEL=stack
LOG_LEVEL=info

# -------------------------------------------------------------------------
# Conexión PostgreSQL Segura
# -------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=restomaster
DB_USERNAME=adminresto
DB_PASSWORD=
DB_SSLMODE=require

# -------------------------------------------------------------------------
# Drivers de Sesión, Caché y Colas Seguras
# -------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
QUEUE_CONNECTION=database
CACHE_STORE=database

# -------------------------------------------------------------------------
# Opciones de Inicialización de Contenedor
# -------------------------------------------------------------------------
AUTO_MIGRATE=true
AUTO_SEED=false
DEMO_USERS_PASSWORD=
OPTIMIZE_CACHE=true

# -------------------------------------------------------------------------
# Notificaciones y Correo
# -------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="notificaciones@restomaster.com"
MAIL_FROM_NAME="${APP_NAME}"
