# =========================================================================
# Sushixpress - Entorno de Producción (Coolify / VPS)
# =========================================================================

APP_NAME="SushiXpress"
APP_ENV=production
APP_KEY=base64:GENERA_TU_PROPIA_APP_KEY_CON_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=http://localhost:8004

LOG_CHANNEL=stack
LOG_LEVEL=info

# -------------------------------------------------------------------------
# Conexión PostgreSQL (Contenedor Postgres)
# -------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sushixpress
DB_USERNAME=sushixpress_user
DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_POR_UNA_SEGURA_DE_32_CARACTERES

# -------------------------------------------------------------------------
# Drivers de Estado y Colas
# -------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# -------------------------------------------------------------------------
# Opciones de Inicialización de Contenedor
# -------------------------------------------------------------------------
AUTO_MIGRATE=true
OPTIMIZE_CACHE=true

# -------------------------------------------------------------------------
# Configuración Opcional de Correo
# -------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="notificaciones@sushixpress.com"
MAIL_FROM_NAME="${APP_NAME}"
